// -> ["Ana", "Bruno"]
 
// A2. ticketsAbertos
// Aqui eu não quero transformar o ticket, só decidir se ele fica ou não na lista.
// "fica ou não fica" é filter, não map.
function ticketsAbertos(
  tickets: { id: number; status: string }[]
): { id: number; status: string }[] {
  const abertos = tickets.filter((ticket) => {
    // comparação sensível a maiúscula/minúscula, então "Aberto" não conta
    return ticket.status === "aberto";
  });
 
  return abertos;
}
 
// A3. contarProdutosProximosDoVencimento
// Primeiro eu filtro quem está a 30 dias ou menos (incluindo os já vencidos,
// que são os negativos), depois só preciso saber QUANTOS sobraram -> .length
function contarProdutosProximosDoVencimento(
  produtos: { nome: string; diasParaVencer: number }[]
): number {
  const proximosOuVencidos = produtos.filter((produto) => {
    return produto.diasParaVencer <= 30;
  });
 
  return proximosOuVencidos.length;
}
 
// A4. precosComDesconto
// Cuidado que eu já caí nessa antes: se eu usar chaves { } no map e esquecer
// o return, o array vem cheio de undefined. Por isso deixei o return bem explícito.
function precosComDesconto(precos: number[], percentual: number): number[] {
  const precosComDescontoAplicado = precos.map((preco) => {
    const fatorDesconto = 1 - percentual / 100;
    const precoComDesconto = preco * fatorDesconto;
 
    // arredondar pra 2 casas decimais: multiplica por 100, arredonda, divide de volta
    const precoArredondado = Math.round(precoComDesconto * 100) / 100;
 
    return precoArredondado;
  });
 
  return precosComDescontoAplicado;
}
 
export {
  nomesDosContatos,
  ticketsAbertos,
  contarProdutosProximosDoVencimento,
  precosComDesconto,
};

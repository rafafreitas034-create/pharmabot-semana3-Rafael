// A1. nomesDosContatos
// Preciso pegar só o campo "nome" de cada contato da lista, sem mexer no resto.
// Isso é claramente um "pra cada item, devolve outra coisa" -> map.
function nomesDosContatos(
  contatos: { nome: string; telefone: string }[]
): string[] {
  const nomes = contatos.map((contato) => {
    return contato.nome;
  });
 
  return nomes;
}
 
// teste rápido que eu rodei no terminal (deixei aqui de lembrete):
// nomesDosContatos([]) -> []

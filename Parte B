// Bônus: ticketMaisAntigoPorFila
// Parecida com a de cima, mas em vez de contar eu guardo o menor id de cada fila.
function ticketMaisAntigoPorFila(
  tickets: { id: number; status: string; fila: string }[]
): Record<string, number> {
  // mesma ideia do passo 1 de cima: só entram tickets abertos com fila preenchida
  const ticketsQueContam = tickets.filter((ticket) => {
    const estaAberto = ticket.status === "aberto";
    const temFila = ticket.fila !== "";
    return estaAberto && temFila;
  });
 
  const maisAntigoPorFila = ticketsQueContam.reduce(
    (acumulador: Record<string, number>, ticket) => {
      const idGuardadoAteAgora = acumulador[ticket.fila];
 
      // se a fila ainda não tem ninguém guardado, esse ticket já é o "mais antigo" dela
      // se já tem alguém, só troco se o id desse ticket for MENOR (mais antigo)
      if (idGuardadoAteAgora === undefined || ticket.id < idGuardadoAteAgora) {
        acumulador[ticket.fila] = ticket.id;
      }
 
      return acumulador;
    },
    {}
  );
 
  return maisAntigoPorFila;
}
 
export { agruparTicketsAbertosPorFila, ticketMaisAntigoPorFila };

// Semana 3 — Parte B
// Fui construindo em duas etapas: primeiro separei quem entra na contagem,
// depois fui somando fila por fila.
 
// agruparTicketsAbertosPorFila
// Regras que eu anotei antes de começar:
// - só conta ticket com status "aberto" (maiúscula/minúscula importa)
// - ticket aberto com fila "" não entra em lugar nenhum, é ignorado
// - fila só aparece no resultado se tiver pelo menos 1 ticket aberto
function agruparTicketsAbertosPorFila(
  tickets: { id: number; status: string; fila: string }[]
): Record<string, number> {
  // Passo 1: separar só quem realmente entra na contagem.
  // Isso já resolve as duas primeiras regras de uma vez (status e fila vazia).
  const ticketsQueContam = tickets.filter((ticket) => {
    const estaAberto = ticket.status === "aberto";
    const temFila = ticket.fila !== "";
    return estaAberto && temFila;
  });
 
  // Passo 2: ir juntando a contagem, fila por fila, num objeto.
  // Comecei o acumulador com {} porque no início nenhuma fila tem contagem ainda.
  const contagemPorFila = ticketsQueContam.reduce(
    (acumulador: Record<string, number>, ticket) => {
      const contagemAtual = acumulador[ticket.fila];
 
      // se a fila ainda não apareceu no acumulador, contagemAtual é undefined
      // então eu trato isso como se fosse 0 antes de somar 1
      if (contagemAtual === undefined) {
        acumulador[ticket.fila] = 1;
      } else {
        acumulador[ticket.fila] = contagemAtual + 1;
      }
 
      return acumulador;
    },
    {}
  );
 
  return contagemPorFila;
}
 
